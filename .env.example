# SERVER: copy to .env at the project root. Never expose secrets in VITE_*.
PORT=3001
HOST=127.0.0.1
FRONTEND_PORT=3000
PRIVY_APP_ID=
PRIVY_APP_SECRET=
MONGODB_URI=
MONGODB_DB=kineticare
GEMINI_API_KEY=
# Available generateContent model ID from your Google AI Studio account.
GEMINI_MODEL=gemini-3.8-flash

# CLIENT: copy only these VITE_* lines to frontend/.env.local.
# Use the same app ID as the backend; the Privy app ID is public configuration.
VITE_PRIVY_APP_ID=
# Leave blank for the same-origin backend / Vite development proxy.
VITE_API_BASE_URL=
