rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function patient() { return signedIn() && profile().role == 'patient'; }
    function clinician() { return signedIn() && profile().role == 'clinician'; }
    function linked(patientUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/relationships/$(patientUid))
        && get(/databases/$(database)/documents/relationships/$(patientUid)).data.active == true
        && get(/databases/$(database)/documents/relationships/$(patientUid)).data.clinicianUid == request.auth.uid;
    }
    function validId(value) { return value is string && value.size() > 0 && value.size() <= 128; }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }
    function invitation() {
      return get(/databases/$(database)/documents/patientInvites/$(request.auth.token.email.lower())).data;
    }
    function claimingInvite(uid) {
      return verifiedEmail() && request.auth.uid == uid
        && invitation().status == 'pending'
        && getAfter(/databases/$(database)/documents/patientInvites/$(request.auth.token.email.lower())).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/patientInvites/$(request.auth.token.email.lower())).data.patientUid == uid;
    }

    match /patientInvites/{email} {
      allow read: if (verifiedEmail() && request.auth.token.email.lower() == email)
        || (clinician() && resource.data.clinicianUid == request.auth.uid);
      allow create: if clinician()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'clinicianUid', 'clinicianName', 'status', 'createdAt'])
        && request.resource.data.email == email && email.size() <= 254
        && request.resource.data.clinicianUid == request.auth.uid
        && request.resource.data.clinicianName == profile().displayName
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100
        && request.resource.data.status == 'pending';
      allow update: if verifiedEmail() && request.auth.token.email.lower() == email
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'patientUid'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.patientUid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient'
        && getAfter(/databases/$(database)/documents/relationships/$(request.auth.uid)).data.clinicianUid == resource.data.clinicianUid;
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (clinician() && linked(uid)));
      allow create: if claimingInvite(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'clinicianUid', 'clinicianName'])
        && request.resource.data.role == 'patient'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.displayName == invitation().displayName
        && request.resource.data.clinicianUid == invitation().clinicianUid
        && request.resource.data.clinicianName == invitation().clinicianName;
      allow update, delete: if false;
    }

    match /relationships/{patientUid} {
      allow read: if signedIn() && (request.auth.uid == patientUid
        || (clinician() && resource.data.clinicianUid == request.auth.uid));
      allow create: if claimingInvite(patientUid)
        && request.resource.data.keys().hasOnly(['clinicianUid', 'active'])
        && request.resource.data.clinicianUid == invitation().clinicianUid
        && request.resource.data.active == true;
      allow update, delete: if false;
    }

    match /references/{referenceId}/versions/{versionId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (patient() && exists(/databases/$(database)/documents/patients/$(request.auth.uid)/referenceAccess/$(versionId)))
      );
      allow create: if clinician()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.referenceId == referenceId
        && request.resource.data.versionId == versionId
        && request.resource.data.exerciseName in ['Squat', 'Side Arm Raise', 'Toe Touch']
        && request.resource.data.status in ['draft', 'approved'];
      allow update: if clinician()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'draft'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.referenceId == resource.data.referenceId
        && request.resource.data.versionId == resource.data.versionId;
      allow delete: if clinician() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'draft';
    }

    match /patients/{patientUid}/assignments/{assignmentId} {
      allow read: if signedIn() && (request.auth.uid == patientUid || (clinician() && linked(patientUid)));
      allow create: if clinician() && linked(patientUid)
        && request.resource.data.patientUid == patientUid
        && request.resource.data.clinicianUid == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 10;
      allow update: if clinician() && linked(patientUid)
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && request.resource.data.patientUid == patientUid
        && request.resource.data.clinicianUid == request.auth.uid;
      allow delete: if false;
    }

    match /patients/{patientUid}/referenceAccess/{versionId} {
      allow read: if signedIn() && (request.auth.uid == patientUid || (clinician() && linked(patientUid)));
      allow create: if clinician() && linked(patientUid)
        && request.resource.data.patientUid == patientUid
        && request.resource.data.clinicianUid == request.auth.uid
        && request.resource.data.versionId == versionId;
      allow update: if clinician() && linked(patientUid)
        && request.resource.data.patientUid == patientUid
        && request.resource.data.clinicianUid == request.auth.uid
        && request.resource.data.versionId == versionId
        && request.resource.data.referenceId == resource.data.referenceId;
      allow delete: if false;
    }

    match /patients/{patientUid}/sessions/{sessionId} {
      allow read: if signedIn() && (request.auth.uid == patientUid || (clinician() && linked(patientUid)));
      allow create: if patient() && request.auth.uid == patientUid
        && request.resource.data.patientUid == patientUid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.exerciseResults is list;
      allow update: if patient() && request.auth.uid == patientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt']);
      allow delete: if false;
    }

    match /patients/{patientUid}/reviews/{sessionId} {
      allow read: if signedIn() && (request.auth.uid == patientUid || (clinician() && linked(patientUid)));
      allow create, update: if clinician() && linked(patientUid)
        && request.resource.data.patientUid == patientUid
        && request.resource.data.clinicianUid == request.auth.uid
        && request.resource.data.sessionId == sessionId;
      allow delete: if false;
    }

    match /patients/{patientUid}/feedback/{feedbackId} {
      allow read: if signedIn() && (request.auth.uid == patientUid || (clinician() && linked(patientUid)));
      allow create: if clinician() && linked(patientUid)
        && request.resource.data.patientUid == patientUid
        && request.resource.data.clinicianUid == request.auth.uid
        && validId(request.resource.data.sessionId)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow update: if patient() && request.auth.uid == patientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /patients/{patientUid}/requests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == patientUid || (clinician() && linked(patientUid)));
      allow create: if patient() && request.auth.uid == patientUid
        && request.resource.data.patientUid == patientUid
        && request.resource.data.creatorId == patientUid
        && request.resource.data.kind in ['help', 'question', 'contact']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow update: if clinician() && linked(patientUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'replies'])
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if false;
    }
  }
}
