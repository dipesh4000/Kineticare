{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "exercise_id", "motion_template_id", "rig_profile_id", "phase_ids", "parameters", "claims", "missing_requirements", "questions"],
  "properties": {
    "status": {"enum": ["needs_clarification", "needs_review", "unsupported", "ready_to_render"]},
    "exercise_id": {"type": ["string", "null"], "pattern": "^EX-KU-[0-9]{6}$"},
    "motion_template_id": {"type": ["string", "null"]},
    "rig_profile_id": {"type": ["string", "null"]},
    "phase_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parameters": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "provenance", "reference_id"],
      "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": ["number", "string", "null"]}, "provenance": {"enum": ["user_request", "reviewed_template", "clinician_configuration", "unknown"]}, "reference_id": {"type": ["string", "null"]}}
    }},
    "claims": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["text", "evidence_unit_ids"],
      "properties": {"text": {"type": "string", "minLength": 1}, "evidence_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^KU-CH[0-9]{2}-[0-9]{4}$"}}}
    }},
    "missing_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ready_to_render"}}}, "then": {"properties": {"exercise_id": {"type": "string"}, "motion_template_id": {"type": "string", "minLength": 1}, "rig_profile_id": {"type": "string", "minLength": 1}, "phase_ids": {"minItems": 1}, "missing_requirements": {"maxItems": 0}, "questions": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["needs_review", "unsupported"]}}}, "then": {"properties": {"missing_requirements": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "needs_clarification"}}}, "then": {"properties": {"questions": {"minItems": 1}}}}
  ]
}
