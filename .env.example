VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_USE_FIREBASE_EMULATORS=

# Copy this file to frontend/.env.local for Vite development/builds.
# Set all six Firebase values above for shared accounts and records.
# Leave them all blank for a browser-local demo. Use false for emulators on deployed builds.
# DATABASE_URL is not used by the active API routes; Firebase stores shared records.

# Optional API origin, without a trailing /api. Leave blank for same-origin requests.
# Vite's dev server mounts /api; static hosting does not deploy that middleware.
# A separate API origin requires backend CORS configuration, which is not implemented.
VITE_API_BASE_URL=
