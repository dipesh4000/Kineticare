{
  "name": "kineticare-root",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/launch.mjs",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "node backend/server.js",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "test": "npm run test:frontend && npm run test:backend && npm run test:replay && npm run test:rules",
    "test:backend": "node --test backend/test/*.test.js",
    "test:frontend": "npm run test --workspace=frontend",
    "test:replay": "node --test test/replayRegression.test.js",
    "test:rules": "node --test test/securityRules.test.js",
    "test:all": "npm test"
  },
  "dependencies": {
    "@privy-io/node": "^0.37.0",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  }
}
